# Gmail SMTP sender address (e.g. yourname@gmail.com)
GMAIL_USER=

# 16-character Google App Password (generate at: https://myaccount.google.com/apppasswords)
# Note: Google accounts with 2-Step Verification do NOT accept standard account passwords for SMTP.
GMAIL_PASSWORD=

# Optional: Recipient email address to receive contact form inquiries (defaults to bemnet.important@gmail.com)
CONTACT_EMAIL=